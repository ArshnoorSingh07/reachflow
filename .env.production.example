# Copy to .env.production on the VM; never commit populated credentials.
# Hostname only, without scheme or path.
APP_DOMAIN=your-vm.region.cloudapp.azure.com
# Generate a random hexadecimal database password.
POSTGRES_PASSWORD=replace-with-random-hex-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-64-hex-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ADMIN_EMAILS=your-google-email@example.com
WORKER_CONCURRENCY=5
MIN_SEND_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=200
ELASTIC_API_KEY=
ELASTIC_USERNAME=
ELASTIC_PASSWORD=
